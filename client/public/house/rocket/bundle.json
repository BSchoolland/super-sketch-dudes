{"id":"rocket","player":"house","name":"ROCKET","tagline":"Nose first, flag on, never lands gently.","description":"","card":["ATTACK  Nose cone ram: aim it up, down or behind","SPECIAL  Homing mini rocket; sideways fires straight, down lights the engine","UP+SPECIAL  Liftoff: steer it home, the exhaust burns below","FUEL  Each rocket costs a third of the tank; empty ones sputter"],"source":"// ROCKET — a flag-painted rocket that fights nose-first and fires smaller rockets at you.\n//   STRIKE   (attack)          NOSE CONE: the rocket rams its pointed nose out. Forward, up, down; charged for the smash.\n//   GIMMICK  (special)         MINI ROCKET: launches a little homing rocket. Costs FUEL, which refills slowly.\n//   RECOVERY (up + special)    LIFTOFF: full throttle upward, the exhaust burns anything underneath.\nexport default function make(api) {\n  const { hb, cap, key, mv, spawnProjectile, spriteAnims, spriteLoops, B } = api;\n\n  const stats = {\n    weight: 84, walk: 3.0, run: 6.0, dashInit: 7, airSpeed: 4.4, airAccel: 0.22,\n    fallSpeed: 6.8, fastFall: 10.5, gravity: 0.42, shortHop: 8, fullHop: 13.5, doubleJump: 12.5,\n    jumps: 2, wallJump: false, traction: 0.45, height: 120, width: 44, crouchHeight: 84, landLag: 4, ledgeReach: 40,\n  };\n\n  const rest = {};\n  const strikePoses = (total, hit, lean, extra = {}) => [\n    key(0, { rot: -lean * 0.4, sx: 0.94, sy: 1.04, dx: -6, ...extra }),\n    key(hit, { rot: lean, sx: 1.14, sy: 0.92, dx: 10, ...extra }),\n    key(Math.min(total - 1, hit + 6), { rot: lean * 0.7, sx: 1.05, sy: 0.98, dx: 6, ...extra }),\n    key(total, rest),\n  ];\n  const NOSE = { fx: \"nose\" };\n  const FUEL_COST = 34;\n\n  const looks = {\n    // the mini rocket is the horizontal rocket from atk-fwd, flames and all, pointed along its flight\n    missile: { cell: \"atk-fwd\", crop: [140, 310, 300, 135], size: 56, aim: true, trail: \"smoke\" },\n    nose: { shape: \"star\", size: 24, color: \"#ffe680\", ink: \"#c93a1c\", texture: \"glow\" },\n    exhaust: { shape: \"blob\", color: \"#e8604c\", ink: \"#c93a1c\", texture: \"flame\" },\n    boom: { shape: \"cloud\", color: \"#f29a3c\", ink: \"#c93a1c\", texture: \"flame\", spin: 4 },\n  };\n\n  // THE STRIKE: the nose cone. Drawn tip positions (U = 0.4): atk-fwd nose at (73,-28), atk-up nose at (0,-118),\n  // atk-down nose at (24,-29) pointing down-forward.\n  const STRIKE = { total: 28, hit: 7, active: 5, damage: 12, r: 19 };\n  const aim = (id, dir, opts = {}) => {\n    const s = { ...STRIKE, ...opts };\n    const start = dir === \"u\" ? [0, -70] : dir === \"d\" ? [-8, -64] : dir === \"b\" ? [-20, -30] : [20, -30];\n    const end = dir === \"u\" ? [0, -126] : dir === \"d\" ? [30, -20] : dir === \"b\" ? [-90, -30] : [90, -30];\n    const angle = dir === \"u\" ? 88 : dir === \"d\" ? 40 : 38;\n    const lean = dir === \"u\" ? -4 : dir === \"d\" ? 8 : dir === \"b\" ? -6 : 6;\n    const extra = dir === \"u\" ? { dy: -8, dx: 0 } : dir === \"d\" ? { dy: 4 } : dir === \"b\" ? { dx: -10 } : {};\n    const cell = dir === \"u\" ? \"atk-up\" : dir === \"d\" ? \"atk-down\" : \"atk-fwd\";\n    return mv(id, s.total, [cap([s.hit, s.hit + s.active - 1], start[0], start[1], end[0], end[1], s.r, s.damage, angle, s.base ?? 38, s.growth ?? 85, { ...NOSE, ...(s.hb ?? {}) })],\n      strikePoses(s.total, s.hit, lean, extra), { cell, cellFlip: dir === \"b\", ...(s.mv ?? {}) });\n  };\n\n  const moves = {\n    jab1: aim(\"jab1\", \"f\", { total: 22, hit: 5, damage: 6, mv: { iasa: 16 } }),\n    ftilt: aim(\"ftilt\", \"f\"),\n    dashAttack: aim(\"dashAttack\", \"f\", { total: 38, hit: 8, active: 6, damage: 12, mv: { motion: [[1, 9, 0], [10, 5, 0], [18, 1, 0]] } }),\n    nair: aim(\"nair\", \"f\", { total: 28, hit: 6, damage: 9, mv: { aerial: true, landingLag: 9 } }),\n    fair: aim(\"fair\", \"f\", { mv: { aerial: true, landingLag: 12 } }),\n    bair: aim(\"bair\", \"b\", { damage: 13, hit: 9, mv: { aerial: true, landingLag: 12 } }),\n    utilt: aim(\"utilt\", \"u\", { damage: 10 }),\n    uair: aim(\"uair\", \"u\", { damage: 10, mv: { aerial: true, landingLag: 10 } }),\n    dtilt: aim(\"dtilt\", \"d\", { damage: 8, total: 26, hit: 7 }),\n    dair: aim(\"dair\", \"d\", { total: 40, hit: 13, damage: 13, hb: { spike: true }, mv: { aerial: true, landingLag: 16 } }),\n    // charged: the whole rocket lunges nose-first with the engine lit\n    fsmash: mv(\"fsmash\", 50, [\n      cap([15, 18], 50, -30, 96, -30, 16, 19, 36, 46, 100, { fx: \"boom\", priority: 0 }),\n      cap([15, 20], 10, -30, 60, -30, 20, 14, 38, 40, 84, { ...NOSE, priority: 1 }),\n      cap([15, 20], -20, -30, -70, -30, 18, 8, 150, 30, 50, { fx: \"exhaust\", group: 1 }),\n    ], strikePoses(50, 15, 8), { smash: true, cell: \"atk-fwd\", motion: [[14, 5, 0], [20, 1, 0]] }),\n    usmash: aim(\"usmash\", \"u\", { total: 48, hit: 14, active: 6, damage: 17, base: 42, growth: 100, mv: { smash: true } }),\n    dsmash: mv(\"dsmash\", 52, [\n      cap([15, 18], 0, -14, 70, -14, 20, 15, 30, 45, 90, { fx: \"exhaust\", group: 0 }),\n      cap([15, 18], 0, -14, -70, -14, 20, 15, 30, 45, 90, { fx: \"exhaust\", group: 1 }),\n    ], [key(0, { sy: 1.04 }), key(14, { sy: 0.8, sx: 1.2, dy: 4 }), key(22, { sy: 0.84, sx: 1.16 }), key(52, rest)], { smash: true, cell: \"idle\", fx: \"quake\" }),\n    // GIMMICK, MINI ROCKET: a slow homing rocket that speeds up and explodes\n    nspecial: mv(\"nspecial\", 42, [], [key(0, { sy: 0.92, sx: 1.06 }), key(12, { sy: 1.1, sx: 0.94, dy: -4 }), key(22, { sy: 1.0 }), key(42, rest)], { hook: \"homer\", cell: \"atk-up\" }),\n    // held sideways: a fast straight rocket, no homing\n    sspecial: mv(\"sspecial\", 40, [], strikePoses(40, 12, 6), { hook: \"dart\", cell: \"atk-fwd\" }),\n    // held down: the engine fires in place, a flame burst around the base\n    dspecial: mv(\"dspecial\", 50, [\n      hb([14, 26], 0, -10, 50, 2, 80, 20, 20, { fx: \"exhaust\", rehit: 4 }),\n      hb([27, 29], 0, -20, 64, 7, 70, 50, 90, { fx: \"boom\", group: 1 }),\n    ], [key(0, { sy: 0.9 }), key(13, { sy: 0.84, sx: 1.12 }), key(14, { sy: 1.12, sx: 0.94, dy: -10 }), key(28, { sy: 1.14, dy: -14 }), key(50, rest)], { hook: \"burn\", cell: \"idle\", fx: \"quake\" }),\n    // RECOVERY, LIFTOFF\n    uspecial: mv(\"uspecial\", 56, [\n      hb([4, 20], 0, 10, 34, 2, 270, 10, 10, { fx: \"exhaust\", rehit: 4 }),\n      cap([8, 12], 0, -80, 0, -126, 16, 6, 85, 50, 70, NOSE),\n    ], [key(0, { sy: 0.84, sx: 1.12 }), key(4, { sy: 1.16, sx: 0.9 }), key(30, { sy: 1.08 }), key(56, rest)], { hook: \"lift\", helpless: true, ledgeOk: true, cell: \"atk-up\" }),\n    ledgeAttack: aim(\"ledgeAttack\", \"f\", { total: 40, hit: 12, damage: 9 }),\n    getupAttack: mv(\"getupAttack\", 44, [cap([12, 15], 10, -30, 80, -30, 18, 7, 40, 40, 60, { ...NOSE, group: 0 }), cap([20, 23], -10, -30, -80, -30, 18, 7, 40, 40, 60, { ...NOSE, group: 1 })], [key(0, rest), key(12, { dx: 8 }), key(20, { dx: -8 }), key(44, rest)], { cell: \"atk-fwd\" }),\n    taunt: mv(\"taunt\", 56, [], [key(0, rest), key(10, { sy: 0.86, sx: 1.1 }), key(18, { sy: 1.14, dy: -24 }), key(30, { sy: 1.05, dy: -30, rot: 8 }), key(42, { sy: 0.9 }), key(56, rest)], { cell: \"atk-up\" }),\n  };\n\n  const fire = (state, f, homing) => {\n    const hit = { frames: [0, 999], x: 0, y: 0, r: 16, damage: homing ? 10 : 9, angle: 45, base: homing ? 44 : 36, growth: homing ? 72 : 60 };\n    if (f.bars.fuel < FUEL_COST) {\n      // out of fuel: it sputters out of the nose and drops\n      spawnProjectile(state, f, \"missile\", f.x + f.moveFacing * 30, f.y - 70, f.moveFacing * 3, -2, 30, { ...hit, damage: 3, base: 20, growth: 20 }, { g: 0.3 });\n      return;\n    }\n    f.bars.fuel -= FUEL_COST;\n    if (homing) spawnProjectile(state, f, \"missile\", f.x + f.moveFacing * 20, f.y - 110, f.moveFacing * 3, -5, 100, hit, { homing: 0.07, homeFrames: 70 });\n    else spawnProjectile(state, f, \"missile\", f.x + f.moveFacing * 50, f.y - 40, f.moveFacing * 12, 0, 60, hit);\n  };\n\n  return {\n    id: \"gen-rocket\",\n    name: \"ROCKET\",\n    tagline: \"Nose first, flag on, never lands gently.\",\n    stats,\n    moves,\n    rig: { anims: spriteAnims(), loops: spriteLoops },\n    palette: { colors: { marker: \"#3d7cc9\" }, outline: \"#262626\" },\n    looks,\n    special: () => ({}),\n    bars: { fuel: { label: \"FUEL\", color: \"#e8604c\", max: 100, start: 100 } },\n    hooks: {\n      homer: ({ state, f }) => { if (f.frame === 12) fire(state, f, true); },\n      dart: ({ state, f }) => { if (f.frame === 12) fire(state, f, false); },\n      burn: ({ f }) => {\n        // the engine lifts it a little off the ground while it burns\n        if (f.frame >= 14 && f.frame <= 26 && !f.grounded) f.vy = Math.min(f.vy, 0.5);\n      },\n      lift: ({ f, input }) => {\n        if (f.frame === 4) { f.grounded = false; f.platform = -1; f.usedUpSpecial = true; }\n        if (f.frame >= 4 && f.frame <= 32) {\n          f.vy = -9 + (f.frame - 4) * 0.22;\n          f.vx = (input.x / 100) * 4.2;\n        }\n      },\n    },\n    onFrame: ({ f }) => { f.bars.fuel += 0.3; },\n    visual: (f) => ({ glow: f.bars.fuel >= 100 ? 0.3 : 0 }),\n  };\n}\n","sprite":{"px":512,"feetPx":448,"heightPx":300,"anims":{},"cells":{"idle":"house/rocket/idle.png","walk":"house/rocket/walk.png","jump":"house/rocket/jump.png","atk-fwd":"house/rocket/atk-fwd.png","atk-up":"house/rocket/atk-up.png","atk-down":"house/rocket/atk-down.png","hit":"house/rocket/hit.png","launched":"house/rocket/launched.png","block":"house/rocket/block.png"}},"cpu":{"version":1,"base":{"specials":{"nspecial":{"groundDx":0,"airDx":-29.47999999999999,"airRise":0,"airDrop":233.9200000000003,"shotRange":271.4696316518846,"held":false,"shotDpf":0.18,"cooldown":41},"sspecial":{"groundDx":0,"airDx":-27.719999999999942,"airRise":0,"airDrop":220.32000000000028,"shotRange":800.3999999999999,"held":false,"shotDpf":0.18,"cooldown":41},"uspecial":{"groundDx":204.28999999999945,"airDx":-19.66999999999993,"airRise":162.77999999999997,"airDrop":-90.3800000000001