{"id":"slugbert","player":"house","name":"SLUGBERT","tagline":"Slow, soggy, and absolutely everywhere.","description":"","card":["ATTACK  snout slap, aim it","SPECIAL  slime glob · side: slide · down: puddle","UP+SPECIAL  goo geyser"],"source":"// SLUGBERT — a spotted garden slug with a stretchy snout and far more slime than is reasonable.\n//   STRIKE   (attack button)   SNOUT SLAP: the snout shoots out like a rubber tongue.\n//   GIMMICK  (special button)  SLIME: spit a glob; sideways it slides on a goo trail; down it lays a sticky puddle.\n//                              Every gimmick spends SLIME, which slowly oozes back. Crawling leaves a trail:\n//                              Slugbert glides at double speed on his own slime, everyone else slips on it.\n//   RECOVERY (up + special)    GOO GEYSER: sneezes a jet of slime at the ground and rides it up.\nexport default function make(api) {\n  const { hb, cap, key, mv, spawnProjectile, spriteAnims, spriteLoops, B } = api;\n\n  const stats = {\n    weight: 100, walk: 2.8, run: 5.2, dashInit: 6, airSpeed: 3.9, airAccel: 0.16,\n    fallSpeed: 6, fastFall: 9.5, gravity: 0.4, shortHop: 7.5, fullHop: 12, doubleJump: 11.5,\n    jumps: 2, wallJump: false, traction: 0.62, height: 120, width: 110, crouchHeight: 70, landLag: 5, ledgeReach: 40,\n  };\n\n  const P = (extra) => ({ ...extra });\n  const rest = P({});\n  // a slug squashes more than it leans\n  const strikePoses = (total, hit, lean, extra = {}) => [\n    key(0, P({ rot: -lean * 0.4, sx: 0.9, sy: 1.1, ...extra })),\n    key(hit, P({ rot: lean, sx: 1.18, sy: 0.88, ...extra })),\n    key(Math.min(total - 1, hit + 6), P({ rot: lean * 0.7, sx: 1.06, sy: 0.96, ...extra })),\n    key(total, rest),\n  ];\n  const SNOUT = { fx: \"snout\" };\n  const looks = {\n    snout: { shape: \"slash\", color: \"#9ddca8\", ink: \"#3d8a52\", texture: \"glow\" },\n    splat: { shape: \"star\", color: \"#b6f0bf\", ink: \"#2f7a45\", texture: \"glow\", spin: 8 },\n    glob: { shape: \"blob\", color: \"#8fd49b\", ink: \"#2f7a45\", texture: \"glow\", trail: \"ghost\", spin: 6 },\n    puddle: { shape: \"puddle\", color: \"#8fd49b\", ink: \"#2f7a45\", texture: \"dots\" },\n    slime: { shape: \"puddle\", color: \"#5fc94a\", ink: \"#1f7a2e\", texture: \"dots\", aim: false },\n    geyser: { shape: \"cloud\", color: \"#a8e0b0\", ink: \"#3d8a52\", texture: \"glow\", spin: 4 },\n  };\n\n  // THE STRIKE: the snout stretches from the face (about 57 units up) out to 82 units, 11 damage.\n  const STRIKE = { total: 28, hit: 7, active: 5, damage: 12, r: 20 };\n  const aim = (id, dir, opts = {}) => {\n    const s = { ...STRIKE, ...opts };\n    const end = dir === \"u\" ? [36, -140] : dir === \"b\" ? [-100, -57] : dir === \"d\" ? [92, -20] : [104, -57];\n    const start = dir === \"u\" ? [8, -90] : dir === \"b\" ? [-20, -57] : dir === \"d\" ? [10, -22] : [20, -57];\n    const angle = dir === \"u\" ? 86 : dir === \"d\" ? 30 : 40;\n    const lean = dir === \"u\" ? -4 : dir === \"b\" ? -14 : dir === \"d\" ? 4 : 10;\n    const extra = dir === \"d\" ? { sy: 0.9, dy: 4 } : dir === \"u\" ? { sy: 1.14, sx: 0.9 } : {};\n    const cell = dir === \"u\" ? \"atk-up\" : dir === \"d\" ? \"atk-down\" : \"atk-fwd\";\n    return mv(id, s.total, [cap([s.hit, s.hit + s.active - 1], start[0], start[1], end[0], end[1], s.r, s.damage, angle, s.base ?? 44, s.growth ?? 88, { ...SNOUT, ...(s.hb ?? {}) })],\n      strikePoses(s.total, s.hit, lean, extra), { cell, cellFlip: dir === \"b\", ...(s.mv ?? {}) });\n  };\n\n  const SLIME_MAX = 100;\n\n  const moves = {\n    jab1: aim(\"jab1\", \"f\", { total: 22, hit: 6, damage: 6, mv: { iasa: 17 } }),\n    ftilt: aim(\"ftilt\", \"f\"),\n    dashAttack: aim(\"dashAttack\", \"f\", { total: 38, hit: 9, damage: 11, mv: { motion: [[1, 6, 0], [12, 3, 0], [20, 1, 0]], cell: \"atk-down\" } }),\n    nair: aim(\"nair\", \"f\", { total: 30, hit: 7, damage: 9, mv: { aerial: true, landingLag: 10 } }),\n    fair: aim(\"fair\", \"f\", { mv: { aerial: true, landingLag: 12 } }),\n    bair: aim(\"bair\", \"b\", { damage: 13, mv: { aerial: true, landingLag: 12 } }),\n    utilt: aim(\"utilt\", \"u\", { damage: 10 }),\n    uair: aim(\"uair\", \"u\", { damage: 10, mv: { aerial: true, landingLag: 10 } }),\n    dtilt: aim(\"dtilt\", \"d\", { damage: 9 }),\n    // belly flop: the whole slug slams down, spiking anyone under it\n    dair: mv(\"dair\", 42, [cap([14, 20], -40, -10, 40, -10, 22, 13, 270, 30, 70, { ...SNOUT, spike: true })],\n      [key(0, P({ sy: 1.1, sx: 0.9 })), key(14, P({ sy: 0.78, sx: 1.22 })), key(24, P({ sy: 0.86, sx: 1.12 })), key(42, rest)],\n      { aerial: true, landingLag: 16, cell: \"atk-down\" }),\n    // the charged slap: the snout snaps out further, with a sweet spot at its tip\n    fsmash: mv(\"fsmash\", 52, [\n      cap([16, 19], 70, -57, 118, -57, 18, 19, 38, 46, 100, { fx: \"splat\", priority: 0 }),\n      cap([16, 21], 20, -57, 80, -57, 22, 14, 40, 40, 82, { ...SNOUT, priority: 1 }),\n    ], strikePoses(52, 16, 14, { dx: 8 }), { smash: true }),\n    usmash: aim(\"usmash\", \"u\", { total: 50, hit: 15, active: 6, damage: 17, base: 42, growth: 98, mv: { smash: true } }),\n    dsmash: mv(\"dsmash\", 54, [\n      cap([16, 19], 10, -24, 100, -22, 22, 15, 30, 45, 88, { ...SNOUT, group: 0 }),\n      cap([22, 25], -10, -24, -100, -22, 22, 15, 30, 45, 88, { ...SNOUT, group: 1 }),\n    ], [key(0, P({ sy: 1.06 })), key(16, P({ sx: 1.25, sy: 0.78 })), key(22, P({ sx: 1.25, sy: 0.78, dx: -10 })), key(54, rest)], { smash: true, cell: \"atk-down\" }),\n    // GIMMICK: spit a glob of slime in an arc\n    nspecial: mv(\"nspecial\", 40, [], [key(0, P({ sy: 1.12, sx: 0.9 })), key(12, P({ sy: 1.16, sx: 0.88, rot: -6 })), key(14, P({ sy: 0.86, sx: 1.16, rot: 8 })), key(26, P({ sy: 0.96 })), key(40, rest)], { hook: \"spit\" }),\n    // sideways: slide forward on a slime trail, body first, leaving a puddle where it started\n    sspecial: mv(\"sspecial\", 44, [cap([8, 22], -20, -40, 50, -30, 30, 10, 38, 45, 70, { ...SNOUT })],\n      [key(0, P({ sy: 1.1, sx: 0.88 })), key(8, P({ sy: 0.78, sx: 1.3 })), key(22, P({ sy: 0.8, sx: 1.26 })), key(44, rest)],\n      { hook: \"slide\", cell: \"atk-down\" }),\n    // down: lay a sticky puddle at your feet that pops the next person who steps in it\n    dspecial: mv(\"dspecial\", 36, [], [key(0, rest), key(10, P({ sy: 0.72, sx: 1.25 })), key(20, P({ sy: 0.74, sx: 1.22 })), key(36, rest)], { hook: \"puddle\", cell: \"block\" }),\n    // RECOVERY: GOO GEYSER, a jet of slime blasts at the ground and carries it up, steerable\n    uspecial: mv(\"uspecial\", 56, [hb([4, 12], 0, 10, 40, 8, 80, 50, 55, { fx: \"geyser\" })],\n      [key(0, P({ sy: 0.72, sx: 1.2 })), key(4, P({ sy: 1.24, sx: 0.84 })), key(30, P({ sy: 1.1, sx: 0.94, rot: 4 })), key(56, P({ rot: -8 }))],\n      { hook: \"geyser\", helpless: true, ledgeOk: true, cell: \"jump\" }),\n    ledgeAttack: aim(\"ledgeAttack\", \"f\", { total: 40, hit: 12, damage: 9 }),\n    getupAttack: mv(\"getupAttack\", 44, [cap([12, 15], 10, -14, 90, -12, 20, 7, 45, 40, 60, { ...SNOUT, group: 0 }), cap([20, 23], -10, -14, -90, -12, 20, 7, 45, 40, 60, { ...SNOUT, group: 1 })], [key(0, rest), key(12, P({ sx: 1.2, sy: 0.82 })), key(20, P({ sx: 1.2, sy: 0.82 })), key(44, rest)], { cell: \"atk-down\" }),\n    taunt: mv(\"taunt\", 56, [], [key(0, rest), key(10, P({ sy: 1.18, sx: 0.88 })), key(20, P({ sy: 0.8, sx: 1.2 })), key(30, P({ sy: 1.18, sx: 0.88 })), key(40, P({ sy: 0.8, sx: 1.2 })), key(56, rest)], { cell: \"atk-up\" }),\n  };\n\n  // spend slime; a dry slug just goes through the motion\n  const spend = (f, cost) => {\n    if (f.bars.slime < cost) return false;\n    f.bars.slime -= cost;\n    return true;\n  };\n  // THE TRAIL: a ring of N slime patches on the special state; each slot is x, y (floor height), w (half-width), t (frames left).\n  // The drawn patch is a projectile that never hits (its hitbox is active on no frame).\n  const N = 16;\n  const stamp = (state, f, x, y, w, life) => {\n    const s = f.special;\n    const i = s.next;\n    s[\"x\" + i] = x; s[\"y\" + i] = y; s[\"w\" + i] = w; s[\"t\" + i] = life;\n    s.next = (i + 1) % N;\n    spawnProjectile(state, f, \"slime\", x, y - 2, 0, 0, life,\n      { frames: [100000, 100000], x: 0, y: 0, r: Math.min(w, 30), damage: 0, angle: 0, base: 0, growth: 0 }, { g: 0 });\n  };\n  const onSlime = (s, x, y) => {\n    for (let i = 0; i < N; i++) {\n      if (s[\"t\" + i] > 0 && Math.abs(y - s[\"y\" + i]) < 6 && Math.abs(x - s[\"x\" + i]) <= s[\"w\" + i]) return true;\n    }\n    return false;\n  };\n  const layPuddle = (state, f, x, life, damage) =>\n    spawnProjectile(state, f, \"puddle\", x, f.y - 6, 0, 0, life,\n      { frames: [0, 999], x: 0, y: 0, r: 30, damage, angle: 88, base: 62, growth: 30 });\n\n  return {\n    id: \"slugbert\",\n    name: \"SLUGBERT\",\n    tagline: \"Slow, soggy, and absolutely everywhere.\",\n    stats,\n    moves,\n    rig: { anims: spriteAnims(), loops: spriteLoops },\n    palette: { colors: { marker: \"#4f9e63\" }, outline: \"#2c3a2e\" },\n    looks,\n    special: () => {\n      const s = { next: 0 };\n      for (let i = 0; i < N; i++) { s[\"x\" + i] = 0; s[\"y\" + i] = 0; s[\"w\" + i] = 0; s[\"t\" + i] = 0; }\n      return s;\n    },\n    hooks: {\n      spit: ({ state, f }) => {\n        if (f.frame === 14 && spend(f, 25)) {\n          spawnProjectile(state, f, \"glob\", f.x + f.moveFacing * 60, f.y - 62, f.moveFacing * 7.5, -5, 90,\n            { frames: [0, 999], x: 0, y: 0, r: 18, damage: 10, angle: 55, base: 38, growth: 55 }, { g: 0.3, bounce: 1 });\n        }\n      },\n      slide: ({ state, f }) => {\n        if (f.frame === 8) {\n          if (f.grounded && spend(f, 30)) layPuddle(state, f, f.x, 200, 5);\n          f.vx = f.moveFacing * 9;\n        }\n        if (f.frame > 8 && f.frame <= 22) f.vx = f.moveFacing * (9 - (f.frame - 8) * 0.45);\n      },\n      puddle: ({ state, f }) => {\n        if (f.frame === 12 && f.grounded && spend(f, 40)) layPuddle(state, f, f.x + f.moveFacing * 20, 360, 9);\n      },\n      geyser: ({ f, input }) => {\n        if (f.frame === 4) { f.grounded = false; f.platform = -1; f.usedUpSpecial = true; }\n        if (f.frame >= 4 && f.frame <= 32) {\n          f.vy = -8.5 + (f.frame - 4) * 0.2;\n          f.vx = (input.x / 100) * 3.8;\n        }\n      },\n    },\n    onFrame: ({ state, f }) => {\n      const s = f.special;\n      for (let i = 0; i < N; i++) if (s[\"t\" + i] > 0) s[\"t\" + i]--;\n      f.bars.slime += 0.3;\n      if (f.grounded) {\n        const slick = onSlime(s, f.x, f.y);\n        const speed = Math.abs(f.vx);\n        // crawling on its own slime: double speed\n        if (slick && speed > 0.5 && speed <= stats.run + 0.5) f.x += f.vx;\n        // fresh ground: leave a patch behind (3 slime each)\n        if (!slick && speed > 1 && f.bars.slime >= 3) { f.bars.slime -= 3; stamp(state, f, f.x, f.y, 14, 180); }\n      }\n      for (const g of state.fighters) {\n        if (g === f || !g.grounded || Math.abs(g.vx) <= 1 || !onSlime(s, g.x, g.y)) continue;\n        // everyone else slips: their slide keeps going\n        g.vx = Math.max(-6, Math.min(6, g.vx + (g.vx > 0 ? 0.25 : -0.25)));\n      }\n    },\n    bars: { slime: { label: \"SLIME\", color: \"#6cc07e\", max: SLIME_MAX, start: SLIME_MAX } },\n  };\n}\n","sprite":{"px":512,"feetPx":448,"heightPx":300,"anims":{},"cells":{"idle":"house/slugbert/idle.png","walk":"house/slugbert/walk.png","jump":"house/slugbert/jump.png","atk-fwd":"house/slugbert/atk-fwd.png","atk-up":"house/slugbert/atk-up.png","atk-down":"house/slugbert/atk-down.png","hit":"house/slugbert/hit.png","launched":"house/slugbert/launched.png","block":"house/slugbert/block.png"}},"cpu":{"version":1,"base":{"specials":{"nspecial":{"groundDx":0,"airDx":-23.039999999999168,"airRise":0,"airDrop":198,"shotRange":755.88,"held":false,"shotDpf":0.05,"cooldown":19.5},"sspecial":{"groundDx":102.01799999999992,"airDx":14.840000000000884,"airRise":0,"airDrop":222,"shotRange":109.21399999999988,