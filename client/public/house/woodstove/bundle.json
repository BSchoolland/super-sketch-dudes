{"id":"woodstove","player":"house","name":"WOODSTOVE","tagline":"Cast iron, two short legs, and a chimney it punches with.","description":"","card":["ATTACK  chimney jab, smoke puff","SPECIAL  hot coal · down: stoke the fire","UP+SPECIAL  flue blast"],"source":"// WOODSTOVE — a cast-iron stove on two stubby legs. Punches with its chimney, lobs coals from its firebox.\n//   STRIKE   (attack)          CHIMNEY JAB: the stovepipe rams out and coughs a puff of smoke. Forward, up, down, charged.\n//   GIMMICK  (special)         HOT COAL: the firebox lobs a bouncing coal. Coals cost HEAT; stoke (down+special) to refill it.\n//   RECOVERY (up + special)    FLUE BLAST: the chimney blows the stove skyward, steerable.\nexport default function make(api) {\n  const { hb, cap, key, mv, spawnProjectile, spriteAnims, spriteLoops, B } = api;\n\n  // heavy, slow, falls like a stove\n  const stats = {\n    weight: 112, walk: 2.4, run: 4.8, dashInit: 5.4, airSpeed: 3.6, airAccel: 0.16,\n    fallSpeed: 8, fastFall: 12.5, gravity: 0.55, shortHop: 9.5, fullHop: 15, doubleJump: 14,\n    jumps: 2, wallJump: false, traction: 0.7, height: 120, width: 50, crouchHeight: 84, landLag: 6, ledgeReach: 40,\n  };\n\n  const P = (extra) => ({ ...extra });\n  const rest = P({});\n  const strikePoses = (total, hit, lean, extra = {}) => [\n    key(0, P({ rot: -lean * 0.5, sx: 0.94, sy: 1.05, ...extra })),\n    key(hit, P({ rot: lean, sx: 1.14, sy: 0.92, ...extra })),\n    key(Math.min(total - 1, hit + 6), P({ rot: lean * 0.8, sx: 1.05, sy: 0.97, ...extra })),\n    key(total, rest),\n  ];\n  const SMOKE = { fx: \"puff\" };\n  const looks = {\n    // the smoke curls cut straight out of the idle drawing\n    puff: { cell: \"idle\", crop: [175, 145, 110, 100], spin: 3 },\n    coal: { shape: \"blob\", color: \"#e8502a\", ink: \"#292722\", texture: \"flame\", trail: \"sparks\", spin: 9 },\n    stoke: { shape: \"ring\", color: \"#ff8a2a\", ink: \"#b8321c\", texture: \"flame\" },\n  };\n\n  // THE STRIKE: the chimney rams out from the top of the box and ends in a smoke puff.\n  const STRIKE = { total: 30, hit: 9, active: 4, damage: 12, r: 20 };\n  const aim = (id, dir, opts = {}) => {\n    const s = { ...STRIKE, ...opts };\n    const start = dir === \"u\" ? [6, -84] : dir === \"b\" ? [-12, -52] : dir === \"d\" ? [16, -60] : [12, -52];\n    const end = dir === \"u\" ? [-22, -124] : dir === \"b\" ? [-84, -54] : dir === \"d\" ? [52, -14] : [84, -54];\n    const angle = dir === \"u\" ? 86 : dir === \"d\" ? 30 : 40;\n    const lean = dir === \"u\" ? -6 : dir === \"b\" ? -16 : dir === \"d\" ? 8 : 12;\n    const extra = dir === \"d\" ? { sy: 0.9, dy: 6 } : dir === \"u\" ? { dy: -4 } : {};\n    const cell = dir === \"u\" ? \"atk-up\" : dir === \"d\" ? \"atk-down\" : \"atk-fwd\";\n    return mv(id, s.total, [cap([s.hit, s.hit + s.active - 1], start[0], start[1], end[0], end[1], s.r, s.damage, angle, s.base ?? 40, s.growth ?? 85, { ...SMOKE, ...(s.hb ?? {}) })],\n      strikePoses(s.total, s.hit, lean, extra), { cell, cellFlip: dir === \"b\", ...(s.mv ?? {}) });\n  };\n\n  const moves = {\n    jab1: aim(\"jab1\", \"f\", { total: 22, hit: 6, damage: 7, mv: { iasa: 17 } }),\n    ftilt: aim(\"ftilt\", \"f\"),\n    dashAttack: aim(\"dashAttack\", \"f\", { total: 38, hit: 9, damage: 12, mv: { motion: [[1, 6.5, 0], [12, 3, 0], [20, 1, 0]] } }),\n    nair: aim(\"nair\", \"f\", { total: 30, hit: 7, damage: 9, mv: { aerial: true, landingLag: 10 } }),\n    fair: aim(\"fair\", \"f\", { mv: { aerial: true, landingLag: 12 } }),\n    bair: aim(\"bair\", \"b\", { damage: 14, mv: { aerial: true, landingLag: 13 } }),\n    utilt: aim(\"utilt\", \"u\", { damage: 10 }),\n    uair: aim(\"uair\", \"u\", { damage: 10, mv: { aerial: true, landingLag: 10 } }),\n    dtilt: aim(\"dtilt\", \"d\", { damage: 9 }),\n    dair: aim(\"dair\", \"d\", { total: 42, hit: 14, damage: 14, hb: { spike: true }, mv: { aerial: true, landingLag: 18 } }),\n    fsmash: mv(\"fsmash\", 54, [\n      cap([17, 20], 50, -54, 104, -56, 22, 19, 38, 46, 94, { fx: \"puff\", priority: 0 }),\n      cap([17, 22], 12, -52, 60, -54, 18, 15, 40, 42, 84, { ...SMOKE, priority: 1 }),\n    ], strikePoses(54, 17, 16), { smash: true }),\n    usmash: aim(\"usmash\", \"u\", { total: 50, hit: 15, active: 6, damage: 17, r: 24, base: 44, growth: 100, mv: { smash: true } }),\n    dsmash: mv(\"dsmash\", 54, [\n      cap([16, 19], 16, -20, 90, -14, 22, 16, 30, 45, 90, { ...SMOKE, group: 0 }),\n      cap([22, 25], -16, -20, -90, -14, 22, 16, 30, 45, 90, { ...SMOKE, group: 1 }),\n    ], [key(0, P({ sy: 0.92 })), key(16, P({ rot: 10, sx: 1.12, sy: 0.84 })), key(22, P({ rot: -10, sx: 1.12, sy: 0.84 })), key(54, rest)], { smash: true, cell: \"atk-down\" }),\n\n    // GIMMICK, HOT COAL: the firebox lobs a bouncing coal (30 heat); out of heat it only coughs smoke\n    nspecial: mv(\"nspecial\", 40, [], [key(0, P({ sy: 0.9, sx: 1.06 })), key(14, P({ rot: 8, sy: 1.08, sx: 0.96 })), key(24, P({ rot: 4 })), key(40, rest)], { hook: \"lob\", cell: \"block\" }),\n    // sideways: the coal is flung flat and fast\n    sspecial: mv(\"sspecial\", 40, [], strikePoses(40, 14, 14), { hook: \"fling\", cell: \"atk-fwd\" }),\n    // down: STOKE. Hold to stoke the fire (refills heat), release to blow a ring of flame out of the box\n    dspecial: mv(\"dspecial\", 62, [\n      hb([27, 30], 0, -46, 58, 9, 60, 46, 90, { fx: \"stoke\" }),\n    ], [key(0, P({ sy: 0.9, sx: 1.08 })), key(25, P({ sy: 0.82, sx: 1.14 })), key(27, P({ sy: 1.14, sx: 1.12 })), key(40, P({ sy: 1.02 })), key(62, rest)], { hook: \"stoke\", cell: \"block\", fx: \"quake\" }),\n\n    // RECOVERY, FLUE BLAST: smoke bursts out under the stove and it rockets up\n    uspecial: mv(\"uspecial\", 58, [cap([5, 10], -20, 6, 20, 6, 30, 7, 80, 40, 60, SMOKE)], [key(0, P({ sy: 0.8, sx: 1.14 })), key(5, P({ sy: 1.18, sx: 0.9 })), key(30, P({ rot: 6 })), key(58, P({ rot: -8 }))], { hook: \"flue\", helpless: true, ledgeOk: true, cell: \"jump\" }),\n\n    ledgeAttack: aim(\"ledgeAttack\", \"f\", { total: 40, hit: 12, damage: 9 }),\n    getupAttack: mv(\"getupAttack\", 44, [cap([12, 15], 10, -40, 84, -30, 20, 7, 45, 40, 60, { ...SMOKE, group: 0 }), cap([20, 23], -10, -40, -84, -30, 20, 7, 45, 40, 60, { ...SMOKE, group: 1 })], [key(0, rest), key(12, P({ rot: 14 })), key(20, P({ rot: -14 })), key(44, rest)], { cell: \"atk-down\" }),\n    taunt: mv(\"taunt\", 50, [], [key(0, rest), key(12, P({ sy: 1.12, sx: 0.92 })), key(24, P({ sy: 0.9, sx: 1.08 })), key(36, P({ sy: 1.12, sx: 0.92 })), key(50, rest)], { cell: \"atk-up\" }),\n  };\n\n  const COAL_COST = 30;\n  const throwCoal = (state, f, vx, vy, g, damage, angle) => {\n    if (f.bars.heat < COAL_COST) {\n      spawnProjectile(state, f, \"puff\", f.x + f.moveFacing * 30, f.y - 50, f.moveFacing * 3, -1, 16,\n        { frames: [0, 999], x: 0, y: 0, r: 16, damage: 2, angle: 40, base: 20, growth: 10 });\n      return;\n    }\n    f.bars.heat -= COAL_COST;\n    spawnProjectile(state, f, \"coal\", f.x + f.moveFacing * 26, f.y - 46, f.moveFacing * vx, vy, 100,\n      { frames: [0, 999], x: 0, y: 0, r: 12, damage, angle, base: 36, growth: 62 }, { g, bounce: 2 });\n  };\n\n  return {\n    id: \"gen-woodstove\",\n    name: \"WOODSTOVE\",\n    tagline: \"Cast iron, two short legs, and a chimney it punches with.\",\n    stats,\n    moves,\n    rig: { anims: spriteAnims(), loops: spriteLoops },\n    palette: { colors: { marker: \"#e8502a\" }, outline: \"#292722\" },\n    looks,\n    special: () => ({}),\n    bars: {\n      heat: { label: \"HEAT\", color: \"#e8502a\", max: 100, start: 60 },\n      charge: { label: \"CHARGE\", color: \"#e8502a\", max: 60, show: (f) => f.move === \"nspecial\", over: true },\n    },\n    hooks: {\n      lob: ({ state, f }) => { if (f.frame === 14) throwCoal(state, f, 5.5, -8.5, 0.45, 9, 55); },\n      fling: ({ state, f }) => { if (f.frame === 14) throwCoal(state, f, 10, -2.5, 0.22, 8, 35); },\n      stoke: ({ f, input }) => {\n        // hold special through frame 24 to stoke (up to 60 frames): heat refills, the flame ring grows\n        if (f.frame <= 24 && f.bars.charge < 60 && (input.b & B.SPECIAL)) {\n          f.bars.charge++;\n          f.bars.heat += 1.2;\n          if (f.frame === 24) f.frame = 23;\n          return;\n        }\n        if (f.frame === 25) {\n          f.chargeMul = 1 + (f.bars.charge / 60) * 0.7;\n          f.bars.charge = 0;\n        }\n      },\n      flue: ({ f, input }) => {\n        if (f.frame === 5) { f.grounded = false; f.platform = -1; f.usedUpSpecial = true; }\n        if (f.frame >= 5 && f.frame <= 36) {\n          f.vy = -9 + (f.frame - 5) * 0.24;\n          f.vx = (input.x / 100) * 4.6;\n        }\n      },\n    },\n    onFrame: ({ f }) => { f.bars.heat += 0.12; },\n    visual: (f) => ({ glow: f.bars.heat / 100 }),\n  };\n}\n","sprite":{"px":512,"feetPx":448,"heightPx":300,"anims":{},"cells":{"idle":"house/woodstove/idle.png","walk":"house/woodstove/walk.png","jump":"house/woodstove/jump.png","atk-fwd":"house/woodstove/atk-fwd.png","atk-up":"house/woodstove/atk-up.png","atk-down":"house/woodstove/atk-down.png","hit":"house/woodstove/hit.png","launched":"house/woodstove/launched.png","block":"house/woodstove/block.png"}},"cpu":{"version":1,"base":{"specials":{"nspecial":{"groundDx":0,"airDx":-21.84000000000077,"airRise":0,"airDrop":265.75,"shotRange":575.4200000000001,"held":false,"shotDpf":0.10666666666666667,"cooldown":41},"sspecial":{"groundDx":0,"airDx":-21.84000000000077,"airRise":0,"airDrop":265.75,"shotRange":1013.92,"held":false,"shotDpf":0.10666666666666667,"cooldown":41},"uspecial":{"groundDx":223.9999999999994,"airDx":36.87999999999869,"airRise":146.32000000000005,"airDrop":-39.219999999999914,"shotRange":0,"held":false,"shotDpf":0.10666666666666667,"cooldown":41},"dspecial":{"groundDx":0,"airDx":-172.14000000000092,"airRise":0,"airDrop":500,"shotRange":0,"held":true,"shotDpf":0.10666666666666667,"cooldown":41}},"shots":{"nspecial":[{"hold":9999,"air":false,"pts":[{"x":31.5,"y":-54.05,"r":12,"t":14},{"x":