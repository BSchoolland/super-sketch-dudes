# systemd --user unit for the forge worker.
# It runs from its own worktree on the live site's build, ~/Projects/sketch-battle-forge-live (forge/live/update.sh moves it).
# Install: cp ~/Projects/sketch-battle-forge-live/forge/forge.service ~/.config/systemd/user/sketch-forge.service
#          systemctl --user daemon-reload && systemctl --user enable --now sketch-forge
# Logs:    journalctl --user -u sketch-forge -f
[Unit]
Description=SKETCH BATTLE forge worker
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/sketch-battle-forge-live
EnvironmentFile=%h/.config/sketch-forge/env
Environment=PATH=%h/.local/share/mise/installs/node/26/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/mise/installs/node/26/bin/npx tsx forge/worker.ts
Restart=always
RestartSec=5
KillMode=control-group

[Install]
WantedBy=default.target
