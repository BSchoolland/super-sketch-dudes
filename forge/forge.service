# systemd --user unit for the forge worker.
# Install: ln -s ~/Projects/sketch-battle-draw/forge/forge.service ~/.config/systemd/user/sketch-forge.service
#          systemctl --user daemon-reload && systemctl --user enable --now sketch-forge
# Logs:    journalctl --user -u sketch-forge -f
[Unit]
Description=SKETCH BATTLE forge worker
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/sketch-battle
EnvironmentFile=%h/.config/sketch-forge/env
Environment=PATH=%h/.local/share/mise/installs/node/26/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/mise/installs/node/26/bin/npx tsx forge/worker.ts
Restart=always
RestartSec=5
KillMode=control-group

[Install]
WantedBy=default.target
