{
  "name": "sketch-battle",
  "version": "0.1.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k \"vite --config client/vite.config.ts\" \"tsx watch server/index.ts\"",
    "build": "vite build --config client/vite.config.ts && esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --packages=external && esbuild scripts/events.ts --bundle --platform=node --format=esm --outfile=dist/events.mjs --packages=external",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && node scripts/lint-determinism.mjs && vitest run",
    "ladder": "tsx scripts/ladder.ts",
    "frames": "tsx scripts/frames.ts",
    "shots": "node scripts/shots.mjs",
    "events": "tsx scripts/events.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.4",
    "esbuild": "^0.23.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "express": "^4.22.3",
    "openai": "^7.23.0",
    "ws": "^8.21.3"
  }
}
